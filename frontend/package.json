{
  "name": "lingroot-frontend",
  "version": "0.1.0",
  "private": true,
  "eslintConfig": {
    "extends": "next/core-web-vitals",
    "rules": {
      "@typescript-eslint/no-explicit-any": "off",
      "@typescript-eslint/no-unused-vars": "off",
      "react-hooks/exhaustive-deps": "off",
      "@next/next/no-img-element": "off",
      "@next/next/no-page-custom-font": "off"
    }
  },
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && NEXT_PUBLIC_API_URL=http://localhost:5001 next dev",
    "build": "cd ../packages/api-client && npm install && npm run build && cd ../../frontend && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.62",
    "@assistant-ui/react": "^0.11.37",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@google-cloud/local-auth": "^3.0.1",
    "@lingroot/api-client": "file:../packages/api-client",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.211.0",
    "@opentelemetry/instrumentation": "^0.211.0",
    "@opentelemetry/instrumentation-document-load": "^0.56.0",
    "@opentelemetry/instrumentation-fetch": "^0.211.0",
    "@opentelemetry/resources": "^2.5.0",
    "@opentelemetry/sdk-trace-web": "^2.5.0",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "@types/node": "^20.17.45",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.2.19",
    "ai": "^5.0.87",
    "autoprefixer": "^10.4.23",
    "axios": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^5.6.0",
    "firebase": "^12.7.0",
    "framer-motion": "^12.23.26",
    "google-auth-library": "^10.1.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.513.0",
    "next": "^14.1.0",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-input-mask": "^2.0.4",
    "recharts": "^2.15.3",
    "socket.io-client": "^4.8.1",
    "swiper": "^11.2.8",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jest": "^30.0.0",
    "@types/react-input-mask": "^3.0.6",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "ts-jest": "^29.4.6"
  }
}
