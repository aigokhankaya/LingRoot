# Treat all text files as text, normalize to LF in repo
* text=auto eol=lf

# Source files
*.js   text eol=lf
*.jsx  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.gradle text eol=lf
*.java  text eol=lf
*.kt    text eol=lf
*.xml   text eol=lf

# Windows scripts should be CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary (no EOL conversion)
*.png  -text
*.jpg  -text
*.jpeg -text
*.gif  -text
*.webp -text
*.ico  -text
*.mp3  -text
*.mp4  -text
*.keystore -text
*.aab -text
*.apk -text