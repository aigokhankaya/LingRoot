# Cloudflare Tunnel Configuration Example
# Bu dosyayı kopyalayıp .env olarak kaydedin ve değerleri doldurun

# Cloudflare Tunnel Bilgileri
TUNNEL_NAME=lingroot-mfa
TUNNEL_DOMAIN=api.lingroot.com

# Backend Ayarları
BACKEND_PORT=5001
BACKEND_HOST=localhost

# Not: Asıl tunnel yapılandırması C:\Users\<kullanıcı>\.cloudflared\config.yml dosyasındadır
# Bu dosya sadece referans amaçlıdır
