# Backend API URL
# Production için:
EXPO_PUBLIC_API_URL=https://lingloops-backend.onrender.com

# Local development için (bilgisayarınızın IP adresini kullanın):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:5001

# Supabase
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google OAuth
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id

# Facebook OAuth (Optional - only if using Facebook Sign-In)
# Get these from https://developers.facebook.com/apps/
# EXPO_PUBLIC_FACEBOOK_APP_ID=your_facebook_app_id
# EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=your_facebook_client_token
